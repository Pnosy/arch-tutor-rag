{
  "$comment": "Arch-Tutor 智能体配置（方案 C：SQLite FTS5 + 直接调用 LLM API + 自定义检索逻辑）",
  "name": "arch-tutor",
  "displayName": "计算机体系结构课程助教",
  "version": "1.0.0",
  "description": "基于《计算机体系结构基础》教材知识库的 RAG 智能问答系统，严格满足 R1~R6 行为约束",

  "knowledgeBase": {
    "type": "sqlite-fts5",
    "path": "data/arch_kb.sqlite",
    "table": "chunks",
    "ftsTable": "chunks_fts",
    "tokenizer": "trigram",
    "ranking": "bm25",
    "buildScript": "scripts/03_build_kb.py",
    "chunkCount": 277,
    "chapterCount": 12,
    "sourcePdf": "计算机体系结构基础.pdf",
    "pageCount": 430
  },

  "tools": [
    {
      "name": "knowledge_search",
      "enabled": true,
      "required": true,
      "description": "检索教材知识库，返回带页码的片段。回答任何课程问题前必须调用。",
      "implementation": "scripts/knowledge_search.py",
      "defaultTopk": 5,
      "maxTopk": 10,
      "relevanceGate": {
        "enabled": true,
        "threshold": 0.34,
        "purpose": "过滤仅因个别词巧合命中的无关片段，防止 R2/R5 违规"
      }
    }
  ],

  "prompt": {
    "file": "prompts/system_prompt.txt",
    "sections": 5,
    "order": -100,
    "constraints": ["R1", "R2", "R3", "R4", "R5", "R6"]
  },

  "ragFlow": {
    "requireRetrievalBeforeAnswer": true,
    "maxRetrievalAttempts": 3,
    "citationFormat": "【教材 p.XX】",
    "maxConsecutiveQuoteSentences": 3,
    "notFoundMessage": "教材未找到相关内容"
  },

  "llm": {
    "provider": "openai-compatible",
    "requiresApiKey": true,
    "apiKeyEnv": "ARCH_TUTOR_API_KEY",
    "baseUrlEnv": "ARCH_TUTOR_BASE_URL",
    "defaultModel": "deepseek-chat",
    "temperature": 0.2,
    "$comment_security": "API Key 仅从环境变量读取，绝不写入本文件或任何提交物"
  },

  "agent": {
    "entry": "agents/arch_tutor_agent.py",
    "dshPlugin": "agents/arch-tutor-plugin.js",
    "offlineMode": {
      "enabled": true,
      "purpose": "无需 API Key 的确定性基线，用于自动化合规性验证"
    }
  }
}
